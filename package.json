{
  "name": "mister_remote",
  "private": true,
  "version": "0.9.0",
  "type": "module",
  "scripts": {
    "build:manuals": "node scripts/build-manuals.mjs",
    "test:manuals": "node --test tests/manuals.test.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "tsx --import ./tests/register-assets.mjs --test tests/*.test.ts",
    "preview": "vite preview",
    "discover-ss-ids": "tsx scripts/discover-ss-ids.ts",
    "build-library": "node ./scripts/parse-launchbox.ts",
    "deploy-mister": "bash scripts/deploy-mister.sh 192.168.0.118",
    "deploy-mister:windows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/deploy-mister.ps1"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-tabs": "^1.1.13",
    "@react-three/fiber": "^9.8.2",
    "@tanstack/react-virtual": "^3.13.23",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router": "^7.14.0",
    "swiper": "^12.1.3",
    "three": "^0.187.0",
    "vaul": "^1.1.2",
    "yet-another-react-lightbox": "^3.28.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "saxes": "^6.0.0",
    "tsx": "^4.21.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4",
    "vite-plugin-pwa": "^1.2.0"
  }
